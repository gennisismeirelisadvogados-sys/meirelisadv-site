---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, wa, tel, msgGeral, legalServiceSchema, faqSchema } from '../data/site';
import { areas } from '../data/areas';

import drHero from '../assets/img/dr-gennisis.jpg';
import drAtendimento from '../assets/img/dr-atendimento.jpg';
import tvBastidores from '../assets/img/tv-bastidores.jpg';
import tvBalanco from '../assets/img/tv-balanco-geral.jpg';
import tvCidade from '../assets/img/tv-cidade-alerta.jpg';
import tvRic from '../assets/img/tv-ric-noticias.jpg';
import tvGolpe from '../assets/img/tv-falso-advogado.jpg';

const situacoes = [
  { t: 'Um familiar foi preso', d: 'Flagrante, custódia, pedido de liberdade', intent: 'prisao',
    msg: 'Olá, Dr. Gennisis. Um familiar foi preso e preciso de ajuda urgente.' },
  { t: 'Estou sendo investigado', d: 'Inquérito, intimação, depoimento na delegacia', intent: 'investigacao',
    msg: 'Olá, Dr. Gennisis. Estou sendo investigado/intimado e preciso de orientação.' },
  { t: 'Recebi uma acusação', d: 'Denúncia, citação, audiência marcada', intent: 'processo',
    msg: 'Olá, Dr. Gennisis. Recebi uma acusação/processo criminal e preciso de defesa.' },
  { t: 'Já houve condenação', d: 'Recurso, execução penal, revisão criminal', intent: 'condenacao',
    msg: 'Olá, Dr. Gennisis. Houve uma condenação e quero avaliar recurso ou revisão.' },
];

const tv = [
  { img: tvBalanco, prog: 'Balanço Geral', d: 'Entrevista exclusiva sobre caso de grande repercussão estadual.', alt: 'Gennisis Meirelis em entrevista no programa Balanço Geral da RIC TV' },
  { img: tvCidade, prog: 'Cidade Alerta', d: 'Análise jurídica sobre o desdobramento de um caso criminal.', alt: 'Gennisis Meirelis em entrevista no programa Cidade Alerta da RIC TV' },
  { img: tvRic, prog: 'RIC Notícias Manhã', d: 'Especialista convidado sobre golpes contra advogados e clientes.', alt: 'Gennisis Meirelis entrevistado no RIC Notícias Manhã' },
  { img: tvGolpe, prog: 'Balanço Geral', d: 'Comentário sobre o golpe do falso advogado e como se proteger.', alt: 'Gennisis Meirelis em reportagem sobre o golpe do falso advogado' },
];

const diferenciais = [
  { icon: 'clock', t: 'Plantão criminal 24 horas', d: 'Prisão não tem hora. Atendo de madrugada, fins de semana e feriados — os primeiros momentos são decisivos.' },
  { icon: 'user', t: 'Você fala direto comigo', d: 'Sem intermediários. Explico cada etapa em linguagem clara e fico disponível para tirar suas dúvidas.' },
  { icon: 'lock', t: 'Sigilo absoluto', d: 'Seu caso é tratado com total confidencialidade, protegida por lei. O que você me conta fica entre nós.' },
  { icon: 'route', t: 'Do flagrante ao recurso', d: 'Inquérito, audiências, júri e recursos. Uma defesa contínua e estratégica, do começo ao fim.' },
] as const;

const depoimentos = [
  { n: 'Lu Avanci', q: 'Excelente profissional, escuta com atenção e compreende o cliente. Recomendo os serviços.' },
  { n: 'Tiago Gomes', q: 'Ótima pessoa e ótimo profissional, me deu todo suporte necessário antes e durante o processo. Recomendo muito!' },
  { n: 'Rhuan Vinicius', q: 'Profissional sério, dedicado e sempre disponível. Quando mais precisei, estava lá. Gratidão pelo trabalho!' },
  { n: 'Família de cliente', q: 'Em um momento muito difícil para a nossa família, o Dr. Gennisis foi a calma e a segurança que precisávamos.' },
];

const faq = [
  { q: 'Vocês atendem a qualquer hora?', a: 'Sim. Mantenho plantão criminal 24 horas, inclusive de madrugada, finais de semana e feriados. Em casos de prisão, os primeiros momentos são os mais importantes — por isso você pode me chamar a qualquer hora pelo WhatsApp.' },
  { q: 'Um familiar acabou de ser preso. O que eu faço?', a: 'Mantenha a calma e entre em contato imediatamente. Evite que a pessoa preste depoimento sem um advogado presente. Me chame no WhatsApp informando o nome, o local da prisão e o que aconteceu — oriento os próximos passos na mesma hora.' },
  { q: 'Fui intimado para depor na delegacia. Preciso de advogado?', a: 'É altamente recomendável. O que é dito no inquérito pode ser usado durante todo o processo. Com orientação antes do depoimento, você sabe quais são seus direitos — inclusive o de permanecer em silêncio.' },
  { q: 'A primeira conversa tem custo?', a: 'A primeira conversa serve para entender o seu caso e esclarecer como posso ajudar. Os honorários são combinados com total transparência, de acordo com a complexidade da causa, e sempre alinhados com você antes de qualquer passo.' },
  { q: 'O atendimento é realmente sigiloso?', a: 'Totalmente. Tudo o que você me contar é protegido pelo sigilo profissional, garantido por lei. A confidencialidade é absoluta, do primeiro contato ao fim do processo.' },
  { q: 'Você atende outras cidades além de Piraquara?', a: 'Atendo Piraquara, Curitiba e toda a região metropolitana presencialmente — São José dos Pinhais, Pinhais, Colombo, Fazenda Rio Grande, Araucária e demais cidades — além de atendimento online para outras localidades.' },
];

const schema = [legalServiceSchema(areas.map((a) => a.t)), faqSchema(faq)];
---
<Base
  title="Advogado Criminal 24h em Piraquara e Curitiba | Gennisis Meirelis Advogados"
  description="Advogado criminalista com plantão 24 horas em Piraquara, Curitiba e Região Metropolitana. Prisão em flagrante, audiência de custódia, habeas corpus. Fale agora no WhatsApp. OAB/PR 119.281."
  schema={schema}
>
  <Header />

  <main>
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Advocacia criminal · Plantão 24h</span>
          <h1 class="h-display hero-h1">Preso em flagrante?<br /><em>As primeiras horas</em> definem o processo.</h1>
          <p class="hero-sub">
            Defesa criminal técnica e imediata em Piraquara, Curitiba e região. Atendo de madrugada,
            fins de semana e feriados — você fala direto com o advogado, sem intermediários.
          </p>
          <div class="hero-ctas">
            <a class="btn btn-whats btn-lg" href={wa(msgGeral)} target="_blank" rel="noopener" data-track="hero">
              <Icon name="whatsapp" />Falar no WhatsApp agora
            </a>
            <a class="btn btn-ghost btn-lg" href={tel} data-track="hero">
              <Icon name="phone" />{site.phoneDisplay}
            </a>
          </div>
          <ul class="trust">
            <li><span class="stars">{[1,2,3,4,5].map(() => <Icon name="star" />)}</span><b>{site.rating.value}</b> no Google</li>
            <li><Icon name="shield" />{site.oab}</li>
            <li><Icon name="tv" />Convidado da RIC TV</li>
          </ul>
        </div>

        <figure class="hero-photo">
          <Image src={drHero} alt="Dr. Gennisis Meirelis, advogado criminalista — OAB/PR 119.281"
            widths={[420, 640, 880]} sizes="(max-width: 900px) 90vw, 440px" loading="eager" fetchpriority="high" />
          <div class="badge-24"><span>24h</span><small>plantão</small></div>
          <figcaption class="photo-card">
            <span class="live"><i></i>Plantão 24h</span>
            <strong>{site.lawyer}</strong>
            <small>Advogado criminalista · {site.oab}</small>
          </figcaption>
        </figure>
      </div>

      <!-- Triagem: cada situação abre o WhatsApp com a mensagem certa -->
      <div class="wrap">
        <div class="triage reveal">
          <p class="triage-q">Qual é a sua situação? <span>Toque e fale comigo na hora.</span></p>
          <div class="triage-grid">
            {situacoes.map((s) => (
              <a class="triage-item" href={wa(s.msg)} target="_blank" rel="noopener" data-track="triagem" data-intent={s.intent}>
                <span><strong>{s.t}</strong><small>{s.d}</small></span>
                <Icon name="arrow" />
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ DOR / EMPATIA ============ -->
    <section class="empathy">
      <div class="wrap empathy-in reveal">
        <p class="empathy-q">Um familiar foi preso? Você está sendo investigado ou acusado?</p>
        <div class="empathy-txt">
          <p>Receber a notícia de uma prisão é um dos momentos mais angustiantes que uma família pode viver.
            As primeiras horas são decisivas — e cada decisão tomada sem orientação pode comprometer toda a defesa.</p>
          <p>Meu trabalho começa exatamente aí: agir rápido, com técnica e firmeza, para proteger seus direitos
            desde o primeiro minuto e devolver a você o controle da situação.</p>
        </div>
      </div>
    </section>

    <!-- ============ ÁREAS ============ -->
    <section id="atuacao" class="areas">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="eyebrow">Áreas de atuação</span>
          <h2 class="h-sec">Defesa criminal <em>em todas as frentes</em></h2>
          <p class="lead">Atuação estratégica em cada fase — do inquérito ao Tribunal do Júri e aos recursos.</p>
        </div>
        <div class="areas-grid">
          {areas.map((a, i) => (
            <article class="area reveal">
              <span class="area-n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{a.t}</h3>
              <p>{a.d}</p>
              <a href={`/atuacao/${a.slug}/`}>Saiba como atuo <Icon name="arrow" /></a>
            </article>
          ))}
          <article class="area area-cta reveal">
            <h3>Não encontrou o seu caso?</h3>
            <p>Atuo em toda a área criminal. Me conte o que aconteceu e eu digo como posso ajudar.</p>
            <a class="btn btn-whats" href={wa(msgGeral)} target="_blank" rel="noopener" data-track="area-outro">
              <Icon name="whatsapp" />Explicar meu caso
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- ============ TV ============ -->
    <section id="tv" class="tv">
      <div class="wrap">
        <div class="tv-top">
          <div class="sec-head reveal">
            <span class="eyebrow">Autoridade reconhecida</span>
            <h2 class="h-sec">Referência <em>procurada pela imprensa</em></h2>
            <p class="lead">Quando um caso criminal ganha repercussão, a TV busca quem entende do assunto.
              A mesma seriedade técnica que levo à imprensa, dedico à defesa de cada cliente.</p>
            <ul class="tv-progs">
              <li>RIC TV · Record</li><li>Balanço Geral</li><li>Cidade Alerta</li><li>RIC Notícias</li>
            </ul>
          </div>
          <figure class="tv-bastidores reveal">
            <Image src={tvBastidores} alt="Equipe de TV gravando entrevista com o advogado no escritório Gennisis Meirelis"
              widths={[400, 640]} sizes="(max-width: 900px) 90vw, 420px" />
            <figcaption>Bastidores de gravação no escritório</figcaption>
          </figure>
        </div>
        <div class="tv-grid">
          {tv.map((v) => (
            <figure class="tv-card reveal">
              <Image src={v.img} alt={v.alt} widths={[360, 560]} sizes="(max-width: 640px) 90vw, 280px" />
              <figcaption><span>RIC TV · {v.prog}</span>{v.d}</figcaption>
            </figure>
          ))}
        </div>
        <p class="tv-note">Conteúdo jornalístico veiculado pela RIC TV (afiliada Record no Paraná). Imagens utilizadas a título informativo.</p>
      </div>
    </section>

    <!-- ============ SOBRE + DIFERENCIAIS ============ -->
    <section id="sobre" class="about">
      <div class="wrap about-grid">
        <figure class="about-photo reveal">
          <Image src={drAtendimento} alt="Dr. Gennisis Meirelis em atendimento no escritório"
            widths={[420, 640]} sizes="(max-width: 900px) 90vw, 460px" />
        </figure>
        <div class="about-copy">
          <div class="reveal">
            <span class="eyebrow">Quem vai defender você</span>
            <h2 class="h-sec">{site.lawyer}</h2>
            <p class="lead">Advogado criminalista inscrito na OAB/PR sob o nº 119.281, com atuação dedicada à
              defesa da liberdade em Piraquara, Curitiba e região metropolitana.</p>
            <blockquote>“Por trás de cada processo existe uma pessoa e uma família. Minha missão é defendê-las
              com técnica, presença e respeito.”</blockquote>
          </div>
          <div class="difs">
            {diferenciais.map((d) => (
              <div class="dif reveal">
                <span class="dif-ic"><Icon name={d.icon} /></span>
                <div><h3>{d.t}</h3><p>{d.d}</p></div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PASSOS ============ -->
    <section class="steps">
      <div class="wrap">
        <div class="sec-head center reveal">
          <span class="eyebrow">Como funciona</span>
          <h2 class="h-sec">Atendimento em <em>3 passos</em></h2>
        </div>
        <ol class="steps-grid">
          <li class="reveal"><span>1</span><h3>Fale agora no WhatsApp</h3><p>Mande uma mensagem a qualquer hora. Você fala diretamente comigo.</p></li>
          <li class="reveal"><span>2</span><h3>Análise e estratégia</h3><p>Avalio seu caso com urgência, esclareço seus direitos e defino o melhor caminho.</p></li>
          <li class="reveal"><span>3</span><h3>Defesa em ação</h3><p>Atuo de imediato — petições, audiências e tudo o que for preciso.</p></li>
        </ol>
        <div class="steps-cta reveal">
          <a class="btn btn-whats btn-lg" href={wa(msgGeral)} target="_blank" rel="noopener" data-track="passos">
            <Icon name="whatsapp" />Começar pelo passo 1
          </a>
        </div>
      </div>
    </section>

    <!-- ============ DEPOIMENTOS ============ -->
    <section id="depoimentos" class="reviews">
      <div class="wrap">
        <div class="reviews-head reveal">
          <div>
            <span class="eyebrow">Avaliações no Google</span>
            <h2 class="h-sec">Confiança construída <em>no momento mais difícil</em></h2>
          </div>
          <div class="score">
            <strong>{site.rating.value}</strong>
            <span class="stars">{[1,2,3,4,5].map(() => <Icon name="star" />)}</span>
            <small>Nota máxima no Google</small>
          </div>
        </div>
        <div class="reviews-grid">
          {depoimentos.map((r) => (
            <figure class="review reveal">
              <span class="stars">{[1,2,3,4,5].map(() => <Icon name="star" />)}</span>
              <blockquote>“{r.q}”</blockquote>
              <figcaption><span class="av">{r.n[0]}</span>{r.n}<small><Icon name="check" />Avaliação Google</small></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section id="faq" class="faq">
      <div class="wrap faq-grid">
        <div class="sec-head reveal">
          <span class="eyebrow">Dúvidas frequentes</span>
          <h2 class="h-sec">Perguntas que talvez você tenha <em>agora</em></h2>
          <p class="lead">Não encontrou sua dúvida? Pergunte direto — respondo pessoalmente.</p>
          <a class="btn btn-ghost" href={wa('Olá, Dr. Gennisis. Tenho uma dúvida sobre um caso criminal.')} target="_blank" rel="noopener" data-track="faq">
            <Icon name="whatsapp" />Tirar minha dúvida
          </a>
        </div>
        <div class="faq-list">
          {faq.map((f, i) => (
            <details class="qa reveal" open={i === 0}>
              <summary>{f.q}<Icon name="plus" /></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CTA FINAL ============ -->
    <section class="final">
      <div class="wrap">
        <div class="final-card reveal">
          <span class="live"><i></i>Plantão criminal 24 horas</span>
          <h2 class="h-display">Sua liberdade <em>não pode esperar.</em></h2>
          <p>Fale agora com o {site.lawyer}. Atendimento imediato, 24 horas, com o sigilo e a seriedade que o seu caso exige.</p>
          <div class="hero-ctas center">
            <a class="btn btn-whats btn-lg" href={wa(msgGeral)} target="_blank" rel="noopener" data-track="final">
              <Icon name="whatsapp" />Falar no WhatsApp
            </a>
            <a class="btn btn-ghost btn-lg" href={tel} data-track="final"><Icon name="phone" />Ligar: {site.phoneDisplay}</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />


</Base>
<style>

  /* Hero */
  .hero { padding: 132px 0 64px; overflow: hidden; }
  .hero-glow { position: absolute; inset: -20% -10% auto auto; width: 70vw; height: 70vw; max-width: 900px; max-height: 900px;
    background: radial-gradient(closest-side, rgba(210, 168, 102, .14), transparent 70%); pointer-events: none; }
  .hero::before { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px; mask-image: radial-gradient(ellipse at 30% 30%, #000 10%, transparent 65%); }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 64px; align-items: center; position: relative; }
  .hero-h1 { font-size: clamp(42px, 6vw, 76px); margin-top: 22px; }
  .hero-sub { color: var(--ink-2); font-size: 19px; max-width: 560px; margin-top: 22px; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
  .hero-ctas.center { justify-content: center; }
  .trust { list-style: none; display: flex; flex-wrap: wrap; gap: 12px 26px; margin-top: 30px; font-size: 14px; color: var(--ink-2); }
  .trust li { display: inline-flex; align-items: center; gap: 8px; }
  .trust li > :global(svg) { width: 18px; height: 18px; color: var(--gold); }
  .trust b { color: var(--ink); }
  .stars { display: inline-flex; gap: 2px; color: #F5B83D; }
  .stars :global(svg) { width: 15px; height: 15px; }

  .hero-photo { position: relative; justify-self: end; width: 100%; max-width: 440px; }
  .hero-photo img { width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: var(--r-lg); box-shadow: var(--shadow); border: 1px solid var(--line-2); }
  .badge-24 { position: absolute; top: 22px; right: -22px; width: 96px; height: 96px; border-radius: 50%; display: grid; place-content: center; text-align: center;
    background: linear-gradient(160deg, var(--gold-2), var(--gold)); color: #1A1206; box-shadow: 0 16px 40px -12px rgba(210, 168, 102, .6); }
  .badge-24 span { font-family: var(--font-display); font-size: 36px; font-weight: 600; line-height: 1; }
  .badge-24 small { font-size: 10px; letter-spacing: .2em; text-transform: uppercase; font-weight: 700; }
  .photo-card { position: absolute; left: -28px; bottom: 28px; padding: 16px 20px; border-radius: var(--r); display: grid; gap: 2px;
    background: rgba(11, 23, 36, .86); backdrop-filter: blur(12px); border: 1px solid var(--line-2); box-shadow: var(--shadow); }
  .photo-card strong { font-family: var(--font-display); font-size: 22px; font-weight: 600; margin-top: 4px; }
  .photo-card small { color: var(--ink-3); font-size: 13px; }

  .triage { margin-top: 72px; padding: 28px; border-radius: var(--r-lg); background: linear-gradient(180deg, var(--bg-3), var(--bg-2)); border: 1px solid var(--line-2); position: relative; }
  .triage-q { font-family: var(--font-display); font-size: 28px; font-weight: 600; margin-bottom: 18px; }
  .triage-q span { font-family: var(--font-ui); font-size: 15px; font-weight: 400; color: var(--ink-3); margin-left: 8px; }
  .triage-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .triage-item { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px; border-radius: var(--r);
    border: 1px solid var(--line); background: rgba(255, 255, 255, .02); transition: border-color .2s, background .2s, transform .2s; }
  .triage-item:hover { border-color: rgba(37, 211, 102, .5); background: rgba(37, 211, 102, .06); transform: translateY(-2px); }
  .triage-item strong { display: block; font-size: 16px; }
  .triage-item small { display: block; color: var(--ink-3); font-size: 13px; line-height: 1.4; margin-top: 4px; }
  .triage-item :global(svg) { width: 20px; height: 20px; flex: none; color: var(--whats); }

  @media (max-width: 1020px) { .triage-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 900px) {
    .hero { padding-top: 108px; }
    .hero-grid { grid-template-columns: 1fr; gap: 48px; }
    .hero-photo { justify-self: center; max-width: 380px; }
    .badge-24 { right: -8px; width: 82px; height: 82px; }
    .photo-card { left: -8px; }
  }
  @media (max-width: 640px) {
    .hero-ctas .btn { width: 100%; }
    .triage { padding: 20px 16px; margin-top: 56px; }
    .triage-q span { display: block; margin: 4px 0 0; }
    .triage-grid { grid-template-columns: 1fr; }
  }

  /* Empatia */
  .empathy { padding: 40px 0 96px; }
  .empathy-in { display: grid; grid-template-columns: .9fr 1.1fr; gap: 56px; padding-top: 56px; border-top: 1px solid var(--line); }
  .empathy-q { font-family: var(--font-display); font-size: clamp(28px, 3.4vw, 40px); line-height: 1.15; font-weight: 600; color: var(--gold-2); }
  .empathy-txt { display: grid; gap: 16px; color: var(--ink-2); font-size: 18px; }
  @media (max-width: 860px) { .empathy-in { grid-template-columns: 1fr; gap: 24px; } }

  /* Áreas */
  .areas { background: var(--bg-2); }
  .areas-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .area { display: flex; flex-direction: column; padding: 28px 24px; border-radius: var(--r-lg); background: var(--bg); border: 1px solid var(--line); transition: border-color .25s, transform .25s; }
  .area:hover { border-color: var(--gold-line); transform: translateY(-4px); }
  .area-n { font-family: var(--font-display); font-size: 20px; color: var(--gold); }
  .area h3 { font-family: var(--font-display); font-size: 25px; font-weight: 600; line-height: 1.15; margin: 14px 0 10px; }
  .area p { color: var(--ink-2); font-size: 15px; flex: 1; }
  .area a { display: inline-flex; align-items: center; gap: 8px; margin-top: 20px; font-size: 14px; font-weight: 600; color: var(--gold-2); }
  .area a :global(svg) { width: 16px; height: 16px; transition: transform .2s; }
  .area a:hover :global(svg) { transform: translateX(4px); }
